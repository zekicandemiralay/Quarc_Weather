<?xml version="1.0" encoding="utf-8"?>
<!-- MINIMAL layout: the weather icon over the temperature, centred. For a single cell or any narrow
     widget. The renderer scales both to the space (WidgetLayoutSpec). Same ids as weather_widget.xml
     (see the notes there); the ids this layout doesn't have are simply not shown. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_solid" />

    <ImageView
        android:id="@+id/widget_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_border"
        android:visibility="gone" />

    <!-- Loading / signed out / no cities. Tiny and wrapping: this layout may be only ~60dp square. -->
    <TextView
        android:id="@+id/widget_message"
        style="@style/WidgetText"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="4"
        android:padding="4dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:visibility="visible" />

    <LinearLayout
        android:id="@+id/widget_data"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="4dp"
        android:paddingTop="2dp"
        android:paddingRight="4dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_icon"
            style="@style/WidgetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/widget_temp"
            style="@style/WidgetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false"
            android:textColor="#FFFFFF"
            android:textSize="26sp" />
    </LinearLayout>
</FrameLayout>
