<?xml version="1.0" encoding="utf-8"?>
<!-- SINGLE ROW layout: [icon] [temperature] [city / condition / high-low] [a few hours].
     For 1-cell-high widgets, or anything the user wants as a slim bar. The renderer hides
     the text column on very narrow widgets and shows as many hour columns as the width
     allows (0-4). Same ids as weather_widget.xml; see the notes there. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_solid" />

    <ImageView
        android:id="@+id/widget_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_border"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_message"
        style="@style/WidgetText"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:padding="8dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="visible" />

    <LinearLayout
        android:id="@+id/widget_data"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingTop="4dp"
        android:paddingRight="12dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_icon"
            style="@style/WidgetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/widget_temp"
            style="@style/WidgetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false"
            android:textColor="#FFFFFF"
            android:textSize="30sp" />

        <!-- City / condition / high-low. Weighted so it takes whatever the hours leave. -->
        <LinearLayout
            android:id="@+id/widget_text_col"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_location_icon"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_marginEnd="3dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_location"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_city"
                    style="@style/WidgetText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_condition"
                style="@style/WidgetText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="#F2FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_hilo"
                style="@style/WidgetText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Up to 4 fixed-width hour columns on the right. -->
        <LinearLayout
            android:id="@+id/widget_hourly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_h0"
                style="@style/WidgetHourColumnInline">

                <TextView
                    android:id="@+id/widget_h0_time"
                    style="@style/WidgetHourTime" />

                <TextView
                    android:id="@+id/widget_h0_icon"
                    style="@style/WidgetHourIcon" />

                <TextView
                    android:id="@+id/widget_h0_temp"
                    style="@style/WidgetHourTemp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_h1"
                style="@style/WidgetHourColumnInline">

                <TextView
                    android:id="@+id/widget_h1_time"
                    style="@style/WidgetHourTime" />

                <TextView
                    android:id="@+id/widget_h1_icon"
                    style="@style/WidgetHourIcon" />

                <TextView
                    android:id="@+id/widget_h1_temp"
                    style="@style/WidgetHourTemp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_h2"
                style="@style/WidgetHourColumnInline">

                <TextView
                    android:id="@+id/widget_h2_time"
                    style="@style/WidgetHourTime" />

                <TextView
                    android:id="@+id/widget_h2_icon"
                    style="@style/WidgetHourIcon" />

                <TextView
                    android:id="@+id/widget_h2_temp"
                    style="@style/WidgetHourTemp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_h3"
                style="@style/WidgetHourColumnInline">

                <TextView
                    android:id="@+id/widget_h3_time"
                    style="@style/WidgetHourTime" />

                <TextView
                    android:id="@+id/widget_h3_icon"
                    style="@style/WidgetHourIcon" />

                <TextView
                    android:id="@+id/widget_h3_temp"
                    style="@style/WidgetHourTemp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
