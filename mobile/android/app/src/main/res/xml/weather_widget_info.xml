<?xml version="1.0" encoding="utf-8"?>
<!-- android:updatePeriodMillis is a fallback the OS enforces a ~30 min floor
     on regardless of the value here — WeatherWidgetWorker's own WorkManager
     schedule (45 min, started in onEnabled) is the real, more precise
     refresh driver. Both exist because a widget must declare *some*
     updatePeriodMillis; relying on it alone would be too coarse and
     unreliable to call "live". -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="160dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/weather_widget"
    android:previewImage="@mipmap/ic_launcher"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
