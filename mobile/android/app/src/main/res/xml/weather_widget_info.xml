<?xml version="1.0" encoding="utf-8"?>
<!-- android:updatePeriodMillis is a fallback the OS enforces a ~30 min floor
     on regardless of the value here — WeatherWidgetWorker's own WorkManager
     schedule (45 min, started in onEnabled) is the real, more precise
     refresh driver. Both exist because a widget must declare *some*
     updatePeriodMillis; relying on it alone would be too coarse and
     unreliable to call "live".

     Size: it used to refuse to shrink below 4x3 cells (250x160dp), which is why a
     "smallest" widget still had a lot of empty space. Now it can go down to a single
     cell, starts as a 2x1, and the layout adapts to whatever size it's given (see
     WidgetLayoutSpec). The minimums are deliberately tiny: a launcher turns them
     into a number of grid cells, and a bigger number here means a bigger footprint
     the user can't shrink. minWidth/minHeight are what launchers before Android 12
     use as the default size; targetCell* is the default on Android 12+.

     configure: the settings screen opens when the widget is added; reconfigurable
     (Android 12+) also lets the launcher offer "reconfigure" from a long press. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/weather_widget_single_row"
    android:previewImage="@mipmap/ic_launcher"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:configure="com.quarc.weather.WidgetConfigActivity"
    android:widgetFeatures="reconfigurable"
    android:description="@string/widget_description" />
